.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #edf1f6;
  padding: 10rpx 0 env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1;
  color: #666666;
}

.tab-item.active .tab-text {
  color: #1677ff;
}
