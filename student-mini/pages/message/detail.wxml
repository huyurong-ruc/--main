<!-- pages/message/detail.wxml -->
<view class="page">
  <view class="header-bg"></view>

  <view wx:if="{{detail && !loading}}" class="content">
    <view class="summary-card">
      <view class="summary-left">
        <view class="badge">{{detail.badgeText || '知'}}</view>
      </view>
      <view class="summary-main">
        <text class="title">{{detail.title}}</text>
        <view class="meta">
          <text class="meta-item">来源：{{detail.publisher || detail.source || '—'}}</text>
          <text class="meta-item">更新时间：{{detail.publishTime || detail.time || '—'}}</text>
        </view>
        <view class="summary-tag" wx:if="{{detail.tag}}">
          <text class="tag-pill personalized">{{detail.tag}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">正文</text>
      <view class="body-card">
        <text class="body-text">{{detail.content}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{detail.actionRoute}}">
      <text class="section-title">站内跳转</text>
      <view class="route-card" bindtap="goToInternalRoute">
        <text class="route-text">{{detail.actionText || '前往办理'}}</text>
        <text class="route-arrow">›</text>
      </view>
    </view>

    <view class="section" wx:if="{{detail.originalUrl && !detail.actionRoute}}">
      <text class="section-title">原文链接</text>
      <view class="link-card" bindtap="copyOriginalLink">
        <text class="link-text">{{detail.originalUrl}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{detail.attachments && detail.attachments.length > 0}}">
      <text class="section-title">附件</text>
      <view class="attach-card">
        <view
          wx:for="{{detail.attachments}}"
          wx:key="id"
          class="attach-item"
          bindtap="downloadAttachment"
          data-url="{{item.url}}"
          data-name="{{item.name}}"
        >
          <text class="attach-name">{{item.name}}</text>
          <text class="attach-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <view wx:if="{{!loading && !detail}}" class="empty-state">
    <text class="empty-title">内容加载失败</text>
    <text class="empty-desc">请返回重试</text>
  </view>
</view>
