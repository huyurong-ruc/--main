/* pages/message/index.wxss */
.page {
  min-height: 100vh;
  background: #f4f7fb;
  padding: 24rpx;
  padding-bottom: calc(24rpx + 120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(21, 42, 72, 0.07);
}

.message-main {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  position: relative;
}

.icon-box.pending { background: #e6fdf0; color: #52c41a; }
.icon-box.feedback { background: #e6f7ff; color: #1677ff; }
.icon-box.personalized { background: #fff7e6; color: #faad14; }

.dot {
  position: absolute;
  right: -6rpx;
  top: -6rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 9rpx;
  background: #ff4d4f;
  border: 4rpx solid #ffffff;
  box-sizing: border-box;
}

.message-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.info-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.message-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d3d;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-time {
  font-size: 22rpx;
  color: #8a98aa;
  flex-shrink: 0;
}

.message-content {
  font-size: 26rpx;
  color: #58677d;
  line-height: 1.6;
  letter-spacing: 0.2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-row {
  display: flex;
  align-items: center;
}

.tag-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  border: 1rpx solid transparent;
}

.tag-pill.personalized {
  background: #fff7e6;
  color: #d46b08;
  border-color: #ffd591;
}

.message-footer {
  border-top: 1rpx solid #edf1f6;
  padding-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-link {
  font-size: 24rpx;
  color: #1f2d3d;
  font-weight: 600;
}

.footer-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-link {
  font-size: 24rpx;
  font-weight: 700;
  color: #1677ff;
}

.arrow {
  font-size: 32rpx;
  color: #cbd5e1;
}
