/* pages/message/detail.wxss */
.page {
  min-height: 100vh;
  background: #f4f7fb;
}

.header-bg {
  height: 320rpx;
  background: linear-gradient(180deg, #8cbcff 0%, #b9d6ff 100%);
}

.content {
  margin-top: -210rpx;
  padding: 0 24rpx 48rpx;
  box-sizing: border-box;
}

.summary-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(21, 42, 72, 0.07);
}

.summary-left {
  width: 72rpx;
  flex-shrink: 0;
}

.badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #e6f7ff;
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 800;
}

.summary-main {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2d3d;
  line-height: 1.35;
  display: block;
}

.meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #8a98aa;
}

.summary-tag {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}

.tag-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border: 1rpx solid transparent;
}

.tag-pill.personalized {
  background: #fff7e6;
  color: #d46b08;
  border-color: #ffd591;
}

.section {
  margin-top: 22rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2d3d;
}

.body-card {
  margin-top: 14rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(21, 42, 72, 0.07);
}

.body-text {
  font-size: 28rpx;
  line-height: 1.9;
  color: #1f2d3d;
  letter-spacing: 0.2rpx;
  white-space: pre-wrap;
}

.link-card {
  margin-top: 14rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(21, 42, 72, 0.07);
}

.link-text {
  color: #1677ff;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
}

.route-card {
  margin-top: 14rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(21, 42, 72, 0.07);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.route-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #1677ff;
  max-width: 560rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-arrow {
  font-size: 34rpx;
  color: #cbd5e1;
}

.attach-card {
  margin-top: 14rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx 0;
  box-shadow: 0 12rpx 32rpx rgba(21, 42, 72, 0.07);
}

.attach-item {
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.attach-item + .attach-item {
  border-top: 1rpx solid #edf1f6;
}

.attach-name {
  font-size: 28rpx;
  color: #1f2d3d;
  max-width: 560rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attach-arrow {
  font-size: 34rpx;
  color: #cbd5e1;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 32rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}
