/* pages/index/index.wxss */
.header-section {
  background: var(--primary-gradient);
  padding: 32rpx 32rpx 120rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.page-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

.search-bar {
  background: #ffffff;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  gap: 12rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #cbd5e1;
}

.banner-box {
  margin-top: -80rpx;
  padding: 0 32rpx;
}

.banner {
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(21, 42, 72, 0.1);
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
  background: #1677ff;
}

.banner-content {
  position: absolute;
  left: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
}

.banner-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

.grid-section {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30rpx 20rpx;
  padding: 40rpx 32rpx;
  background: #ffffff;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.icon-box.search { background: #1890ff; }
.icon-box.policy { background: #722ed1; }
.icon-box.template { background: #13c2c2; }
.icon-box.apply { background: #f5222d; }
.icon-box.party { background: #fa8c16; }
.icon-box.academic { background: #52c41a; }
.icon-box.notice { background: #2f54eb; }
.icon-box.faq { background: #10239e; }

.icon-image {
  width: 36rpx;
  height: 36rpx;
}

.grid-name {
  font-size: 24rpx;
  color: #1f2d3d;
}

.section {
  margin-top: 24rpx;
  background: #ffffff;
  padding: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.section-more {
  font-size: 24rpx;
  color: #8a98aa;
}

.progress-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.progress-card {
  display: flex;
  padding: 24rpx;
  background: #f8f9fb;
  border-radius: 16rpx;
  gap: 20rpx;
}

.progress-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.progress-icon.apply { color: #1677ff; }
.progress-icon.party { color: #faad14; }

.progress-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.progress-top, .progress-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.progress-status {
  font-size: 22rpx;
}

.progress-status.warning { color: #faad14; }
.progress-status.primary { color: #1677ff; }

.progress-desc {
  font-size: 22rpx;
  color: #58677d;
}

.progress-time {
  font-size: 20rpx;
  color: #8a98aa;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.notice-item {
  border-bottom: 1rpx solid #edf1f6;
  padding-bottom: 24rpx;
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2d3d;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: block;
}

.notice-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #8a98aa;
}
