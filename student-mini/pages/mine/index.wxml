<!-- pages/mine/index.wxml -->
<view class="container">
  <view class="user-header">
    <view class="user-main">
      <image class="avatar" src="/static/images/avatar.png" />
      <view class="user-info">
        <text class="user-name">张晓丽</text>
        <text class="user-id">2024级本科生2班</text>
      </view>
    </view>
    <view class="info-row">
      <view class="info-tag">
        <text class="tag-icon">👤</text>
        <text class="tag-text">2020201105</text>
      </view>
      <view class="info-tag">
        <text class="tag-icon">🎓</text>
        <text class="tag-text">计算机科学与技术</text>
      </view>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goToInfo">
      <view class="menu-left">
        <text class="menu-icon">📄</text>
        <text class="menu-text">我的信息</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToSettings">
      <view class="menu-left">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">常用设置</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToFeedback">
      <view class="menu-left">
        <text class="menu-icon">💬</text>
        <text class="menu-text">意见反馈</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="clearCache">
      <view class="menu-left">
        <text class="menu-icon">🗑️</text>
        <text class="menu-text">清除缓存</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
