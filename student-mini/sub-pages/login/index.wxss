.container {
  background: #ffffff;
  padding: 96rpx 60rpx 220rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.login-content {
  display: flex;
  flex-direction: column;
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
}

.header {
  flex: 1;
  min-width: 0;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #8a98aa;
  margin-top: 16rpx;
}

.illustration {
  width: 300rpx;
  height: 220rpx;
  flex-shrink: 0;
}

.form {
  margin-top: 84rpx;
  margin-bottom: 60rpx;
}

.input-group {
  border-bottom: 1rpx solid #edf1f6;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
  position: relative;
}

.input-group.error {
  border-bottom-color: #ff4d4f;
}

.input {
  font-size: 30rpx;
  color: #1f2d3d;
}

.placeholder {
  color: #cbd5e1;
}

.error-text {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #ff4d4f;
  line-height: 1.4;
}

.login-btn {
  margin-top: 60rpx;
  background: #1677ff;
  color: #ffffff;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 32rpx rgba(22, 119, 255, 0.2);
}

.login-btn::after {
  border: none;
}

.login-btn.disabled {
  opacity: 0.55;
  box-shadow: none;
}

.agreement {
  font-size: 24rpx;
  color: #8a98aa;
  text-align: center;
  position: fixed;
  bottom: 80rpx;
  left: 0;
  right: 0;
}

.link {
  color: #1677ff;
}
