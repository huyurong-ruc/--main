<!-- sub-pages/apply/list.wxml -->
<view class="page">
  <view class="header-bg">
    <view class="search-panel">
      <view class="search-box" bindtap="focusSearch">
      <icon type="search" size="16" color="#cbd5e1" />
        <input
          class="search-input"
          placeholder="搜索申请类型、状态或时间"
          value="{{keyword}}"
          focus="{{searchInputFocus}}"
          confirm-type="search"
          bindfocus="onSearchFocus"
          bindblur="onSearchBlur"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
        <text wx:if="{{keyword}}" class="search-clear" catchtap="clearSearch">清除</text>
      </view>

      <view wx:if="{{showSuggestions}}" class="suggestion-panel">
        <view wx:if="{{suggestionList.length > 0}}">
          <view
            wx:for="{{suggestionList}}"
            wx:key="id"
            class="suggestion-item"
            catchtap="selectSuggestion"
            data-keyword="{{item.title}}"
          >
            <text class="suggestion-title">{{item.title}}</text>
            <text class="suggestion-status">{{item.status}}</text>
          </view>
        </view>
        <view wx:else class="suggestion-empty">暂无匹配的申请联想</view>
      </view>
    </view>
  </view>

  <view class="content">
    <view class="panel">
      <view class="panel-head">
        <view class="panel-meta">
          <text class="panel-title">我的证明/申请</text>
          <text class="panel-sort">未完成优先，其次按提交时间倒序</text>
        </view>
        <view class="create-btn" bindtap="goToCreate">+ 新建申请</view>
      </view>

      <view wx:if="{{applyList.length > 0}}" class="record-list">
        <view
          wx:for="{{applyList}}"
          wx:key="id"
          class="record-item"
          bindtap="goToDetail"
          data-id="{{item.id}}"
        >
          <view class="record-left">
            <view class="record-icon">{{item.iconText}}</view>
            <view class="record-main">
              <text class="record-title">{{item.title}}</text>
              <text class="status-pill status-{{item.statusClass}}">{{item.status}}</text>
            </view>
          </view>
          <text class="record-time">申请时间：{{item.time}}</text>
        </view>
      </view>
      <view wx:else class="empty-state">
        <text class="empty-title">{{emptyText}}</text>
        <text class="empty-desc">点击右上角“新建申请”即可发起新的证明申请</text>
      </view>
    </view>
  </view>
</view>
