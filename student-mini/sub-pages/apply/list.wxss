/* sub-pages/apply/list.wxss */
.page {
  min-height: 100vh;
  background: #f4f7fb;
}

.header-bg {
  background: linear-gradient(180deg, #1677ff 0%, #4096ff 100%);
  padding: 24rpx 32rpx 140rpx;
}

.search-box {
  background: #ffffff;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 26rpx;
  gap: 14rpx;
  box-shadow: 0 12rpx 32rpx rgba(21, 42, 72, 0.1);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1f2d3d;
}

.content {
  margin-top: -96rpx;
  padding: 0 24rpx 24rpx;
}

.panel {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(21, 42, 72, 0.07);
}

.panel-head {
  padding: 28rpx 28rpx 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-bottom: 1rpx solid #edf1f6;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.panel-sort {
  font-size: 24rpx;
  color: #8a98aa;
}

.record-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #edf1f6;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-width: 0;
}

.record-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: #e6f7ff;
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.record-main {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  min-width: 0;
}

.record-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2d3d;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-pill {
  align-self: flex-start;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-warning {
  background: #fff7e6;
  color: #faad14;
}

.status-primary {
  background: #e6f7ff;
  color: #1677ff;
}

.status-success {
  background: #f6ffed;
  color: #52c41a;
}

.record-time {
  font-size: 24rpx;
  color: #8a98aa;
  flex-shrink: 0;
  margin-left: 18rpx;
}
