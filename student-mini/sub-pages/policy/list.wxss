.page {
  min-height: 100vh;
  background: #f4f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  min-height: 220rpx;
  border-radius: 16rpx;
  padding: 34rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #108ee9 0%, #1677ff 58%, #40a9ff 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  box-shadow: 0 18rpx 42rpx rgba(22, 119, 255, 0.24);
}

.hero-kicker {
  display: block;
  font-size: 22rpx;
  opacity: 0.78;
  letter-spacing: 0;
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 800;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
  opacity: 0.9;
}

.hero-medal {
  width: 116rpx;
  height: 116rpx;
  border-radius: 58rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.search-card {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 0 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(24, 52, 92, 0.06);
}

.tabs {
  display: flex;
  height: 88rpx;
  align-items: center;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #58677d;
  position: relative;
  height: 100%;
}

.tab-item.active {
  color: #1677ff;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  background: #1677ff;
  border-radius: 3rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-bottom: 40rpx;
}

.policy-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 52, 92, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.policy-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
  line-height: 1.4;
  flex: 1;
  padding-right: 20rpx;
}

.type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #e6f7ff;
  color: #1890ff;
  flex-shrink: 0;
}

.type-tag.notice { background: #f6ffed; color: #52c41a; }
.type-tag.template { background: #fff7e6; color: #faad14; }

.card-content {
  margin-bottom: 20rpx;
}

.policy-summary {
  font-size: 26rpx;
  color: #58677d;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.template-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.template-icon {
  font-size: 40rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #f2f5f9;
  padding-top: 20rpx;
  margin-top: 10rpx;
}

.policy-time {
  font-size: 22rpx;
  color: #7b8ba5;
}

.detail-link {
  font-size: 24rpx;
  color: #1677ff;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-illustration {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #7b8ba5;
  text-align: center;
}

.loading-state, .load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #7b8ba5;
}
