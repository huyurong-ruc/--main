<!-- sub-pages/search/index.wxml -->
<view class="container">
  <!-- 搜索框 -->
  <view class="search-header">
    <view class="search-input-box">
      <icon type="search" size="14" color="#cbd5e1" />
      <input 
        class="search-input" 
        type="text" 
        placeholder="搜索政策/通知/功能/办事模块"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="handleSearch"
        auto-focus
      />
      <icon wx:if="{{keyword}}" type="clear" size="16" color="#cbd5e1" bindtap="clearSearch" />
    </view>
    <text class="cancel-btn" bindtap="goBack">取消</text>
  </view>

  <view wx:if="{{!hasResult && keyword && suggestionList.length > 0}}" class="suggestion-panel">
    <view class="suggestion-header">
      <text class="section-title">联想推荐</text>
    </view>
    <view
      wx:for="{{suggestionList}}"
      wx:key="id"
      class="suggestion-card"
      bindtap="onSuggestionTap"
      data-item="{{item}}"
    >
      <view class="suggestion-icon {{item.typeClass}}">{{item.typeIcon || ''}}</view>
      <view class="suggestion-content">
        <text class="suggestion-title">{{item.title}}</text>
        <text class="suggestion-desc">{{item.desc}}</text>
      </view>
      <text class="suggestion-entry">{{item.entryLabel}}</text>
    </view>
  </view>
  
  <!-- 搜索结果 -->
  <view wx:if="{{hasResult}}" class="result-section">
    <view class="result-tabs">
      <view 
        wx:for="{{tabs}}" 
        wx:key="*this"
        class="tab-item {{activeTab === index ? 'active' : ''}}"
        bindtap="onTabChange"
        data-index="{{index}}"
      >
        <text>{{item}}</text>
        <view class="tab-line" wx:if="{{activeTab === index}}"></view>
      </view>
    </view>
    
    <view class="result-list">
      <view 
        wx:for="{{filteredList}}"
        wx:key="id"
        class="result-card"
        bindtap="goToDetail"
        data-item="{{item}}"
      >
        <view class="card-icon {{item.typeClass}}">{{item.typeIcon}}</view>
        <view class="card-content">
          <view class="card-title">
            <text
              wx:for="{{item.titleSegments}}"
              wx:key="index"
              class="highlight-text {{item.highlight ? 'active' : ''}}"
            >{{item.text}}</text>
          </view>
          <view class="card-summary">
            <text
              wx:for="{{item.bodySegments}}"
              wx:key="index"
              class="highlight-text {{item.highlight ? 'active' : ''}}"
            >{{item.text}}</text>
          </view>
          <view class="card-meta">
            <text class="meta-source">{{item.metaLeft}}</text>
            <text class="meta-time">{{item.metaRight}}</text>
          </view>
          <view wx:if="{{item.type === 'service'}}" class="service-entry">
            <text
              wx:for="{{item.entrySegments}}"
              wx:key="index"
              class="highlight-text {{item.highlight ? 'active' : ''}}"
            >{{item.text}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{filteredList.length === 0}}" class="empty-state">
        <text class="empty-title">暂无匹配内容</text>
        <text class="empty-desc">未找到与“{{keyword}}”相关的文件、功能模块或办事服务</text>
        <text class="empty-desc">建议检查关键词拼写，或尝试使用模块名称、办事别名、流程关键词重新搜索</text>
      </view>
    </view>
  </view>
  
  <!-- 搜索前 -->
  <view wx:else class="search-entry">
    <view class="section">
      <view class="section-header">
        <text class="section-title">搜索历史</text>
        <icon type="clear" size="14" color="#8a98aa" bindtap="clearHistory" />
      </view>
      <view class="tag-list">
        <view class="tag" wx:for="{{historyList}}" wx:key="*this" bindtap="onTagTap" data-word="{{item}}">{{item}}</view>
      </view>
    </view>
    
    <view class="section">
      <view class="section-header">
        <text class="section-title">常见搜索</text>
      </view>
      <view class="tag-list">
        <view class="tag" wx:for="{{hotList}}" wx:key="*this" bindtap="onTagTap" data-word="{{item}}">{{item}}</view>
      </view>
    </view>
  </view>
</view>
