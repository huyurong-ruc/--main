<!-- sub-pages/growth/archive.wxml -->
<view class="page">
  <view class="hero">
    <view class="hero-main">
      <view class="avatar">{{avatarText}}</view>
      <view class="hero-text">
        <text class="hero-name">{{profileCard.name || '个人档案'}}</text>
        <text class="hero-sub">{{profileCard.studentNo || ''}}{{profileCard.collegeName ? ' · ' + profileCard.collegeName : ''}}</text>
      </view>
    </view>

    <view class="hero-tags" wx:if="{{identityTags.length}}">
      <text class="hero-tag" wx:for="{{identityTags}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="metric-row">
      <view class="metric-item">
        <text class="metric-value">{{totalRecordCount}}</text>
        <text class="metric-label">档案记录</text>
      </view>
      <view class="metric-item">
        <text class="metric-value">{{moduleCount}}</text>
        <text class="metric-label">成长模块</text>
      </view>
      <view class="metric-item">
        <text class="metric-value">{{activeModuleCount}}</text>
        <text class="metric-label">已登记</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">基础信息</text>
    </view>
    <view class="profile-card">
      <view class="profile-grid">
        <view class="profile-item" wx:for="{{profileItems}}" wx:key="label">
          <text class="profile-label">{{item.label}}</text>
          <text class="profile-value">{{item.value}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">成长模块</text>
      <text class="section-sub" wx:if="{{modules.length}}">{{modules.length}}个模块</text>
    </view>

    <view wx:if="{{modules.length}}" class="module-list">
      <view
        wx:for="{{modules}}"
        wx:key="moduleCode"
        class="module-card"
        bindtap="goToModule"
        data-module-code="{{item.moduleCode}}"
      >
        <view class="module-top">
          <view class="module-icon">{{item.iconText}}</view>
          <view class="module-meta">
            <text class="module-title">{{item.moduleName}}</text>
            <text class="module-desc">{{item.description}}</text>
          </view>
          <view class="module-side">
            <text class="badge badge-{{item.editable ? 'self' : 'disabled'}}">{{item.editModeLabel}}</text>
            <text class="module-count">{{item.recordCount}}条</text>
          </view>
        </view>

        <view class="module-chips" wx:if="{{item.awardTypeSummary && item.awardTypeSummary.length}}">
          <text class="chip" wx:for="{{item.awardTypeSummary}}" wx:key="*this">{{item}}</text>
        </view>

        <view class="module-preview" wx:if="{{item.previewRecords && item.previewRecords.length}}">
          <text class="preview-title">{{item.previewRecords[0].summary}}</text>
          <text class="preview-time">{{item.previewRecords[0].updatedAt}}</text>
        </view>

        <view class="module-actions">
          <button
            wx:if="{{item.editable}}"
            size="mini"
            class="mini-btn mini-primary"
            data-module-code="{{item.moduleCode}}"
            catchtap="goToAdd"
          >新增</button>
          <button
            size="mini"
            class="mini-btn"
            data-module-code="{{item.moduleCode}}"
            catchtap="goToModule"
          >查看</button>
        </view>
      </view>
    </view>

    <view wx:else class="empty-card">
      <text class="empty-title">暂无可展示内容</text>
      <text class="empty-desc">请稍后重试，或联系管理员确认档案权限与数据状态</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-mask">
    <text class="loading-text">加载中...</text>
  </view>
</view>
