.page {
  min-height: 100vh;
  background: #f4f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  min-height: 220rpx;
  border-radius: 16rpx;
  padding: 34rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #00bfa5 0%, #00acc1 58%, #0097a7 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  box-shadow: 0 18rpx 42rpx rgba(0, 172, 193, 0.24);
}

.hero-kicker {
  display: block;
  font-size: 22rpx;
  opacity: 0.78;
  letter-spacing: 0;
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 800;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
  opacity: 0.9;
}

.hero-medal {
  width: 116rpx;
  height: 116rpx;
  border-radius: 58rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.result-meta {
  padding: 24rpx 10rpx 12rpx;
  font-size: 24rpx;
  color: #7b8ba5;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 40rpx;
}

.feedback-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 52, 92, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.feedback-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.status-pill {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #f2f5f9;
  color: #58677d;
}

.status-pill.pending { background: #fff7e6; color: #faad14; }
.status-pill.processing { background: #e6f7ff; color: #1890ff; }
.status-pill.completed { background: #f6ffed; color: #52c41a; }

.card-content {
  margin-bottom: 20rpx;
}

.feedback-content {
  font-size: 26rpx;
  color: #58677d;
  line-height: 1.6;
}

.card-footer {
  border-top: 1rpx solid #f2f5f9;
  padding-top: 16rpx;
}

.feedback-time {
  font-size: 22rpx;
  color: #7b8ba5;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-illustration {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #7b8ba5;
  text-align: center;
}

.loading-state {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #7b8ba5;
}
