<view class="page">
  <view class="hero">
    <view>
      <text class="hero-kicker">FEEDBACK HISTORY</text>
      <text class="hero-title">反馈历史</text>
      <text class="hero-subtitle">查看您提交的所有意见建议、问题反馈及其处理状态</text>
    </view>
    <view class="hero-medal">听</view>
  </view>

  <view class="result-meta" wx:if="{{history.length > 0}}">
    <text>共 {{history.length}} 条反馈记录</text>
  </view>

  <view class="list">
    <view wx:for="{{history}}" wx:key="id" class="feedback-card">
      <view class="card-header">
        <text class="feedback-type">{{item.typeName}}</text>
        <text class="status-pill {{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="card-content">
        <text class="feedback-content">{{item.content}}</text>
      </view>
      <view class="card-footer">
        <text class="feedback-time">{{item.createTime}}</text>
      </view>
    </view>
    
    <view wx:if="{{!loading && history.length === 0}}" class="empty-state">
      <image src="/static/illustrations/feedback.svg" class="empty-illustration" mode="aspectFit" />
      <text class="empty-title">暂无反馈记录</text>
      <text class="empty-desc">您的声音对我们非常重要</text>
    </view>
  </view>
  
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>
</view>
