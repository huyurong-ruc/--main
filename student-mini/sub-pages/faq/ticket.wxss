/* sub-pages/faq/ticket.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-chip {
  font-size: 26rpx;
  color: #666;
  background: #fff;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e8e8e8;
}

.filter-chip.active {
  color: #1677ff;
  background: #e6f4ff;
  border-color: #1677ff;
}

/* 错误卡片 */
.error-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.error-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.error-action {
  display: inline-block;
  font-size: 28rpx;
  color: #1677ff;
  padding: 12rpx 32rpx;
  border: 1rpx solid #1677ff;
  border-radius: 8rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.ticket-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.ticket-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.ticket-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.ticket-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}

.status-open {
  background: #fff7e6;
  color: #fa8c16;
}

.status-progress {
  background: #e6f4ff;
  color: #1677ff;
}

.status-closed {
  background: #f5f5f5;
  color: #999;
}

.status-unknown {
  background: #f5f5f5;
  color: #999;
}

.ticket-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.ticket-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ticket-time {
  font-size: 24rpx;
  color: #999;
}

.ticket-reply {
  font-size: 24rpx;
  color: #1677ff;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading-more {
  text-align: center;
  padding: 32rpx;
  color: #999;
  font-size: 24rpx;
}
