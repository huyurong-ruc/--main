.page {
  min-height: 100vh;
  background: #f4f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  min-height: 220rpx;
  border-radius: 16rpx;
  padding: 34rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #108ee9 0%, #1677ff 58%, #40a9ff 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  box-shadow: 0 18rpx 42rpx rgba(22, 119, 255, 0.24);
}

.hero-kicker {
  display: block;
  font-size: 22rpx;
  opacity: 0.78;
  letter-spacing: 0;
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 800;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
  opacity: 0.9;
}

.hero-medal {
  width: 116rpx;
  height: 116rpx;
  border-radius: 58rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.search-card {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(24, 52, 92, 0.06);
}

.search-box {
  height: 76rpx;
  border-radius: 12rpx;
  background: #f3f6fb;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  gap: 14rpx;
}

.search-icon,
.clear-btn {
  color: #7b8ba5;
  font-size: 32rpx;
}

.search-box input {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #1f2d3d;
}

.result-meta {
  padding: 24rpx 10rpx 12rpx;
  font-size: 24rpx;
  color: #7b8ba5;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 180rpx;
}

.faq-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 52, 92, 0.04);
  transition: all 0.3s ease;
}

.faq-card.expanded {
  background: #ffffff;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.question-block {
  flex: 1;
  padding-right: 20rpx;
}

.question-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
  line-height: 1.4;
}

.question-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a94a6;
  line-height: 1.4;
}

.toggle-icon {
  font-size: 32rpx;
  color: #cbd5e1;
  transition: transform 0.3s;
}

.faq-card.expanded .toggle-icon {
  transform: rotate(180deg);
  color: #1677ff;
}

.card-content {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f2f5f9;
}

.answer-text {
  font-size: 26rpx;
  color: #58677d;
  line-height: 1.6;
}

.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 40rpx calc(30rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f4f7fb 80%, rgba(244, 247, 251, 0));
  z-index: 10;
}

.primary-btn {
  width: 100% !important;
  height: 96rpx;
  background: #1677ff;
  color: #ffffff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 32rpx rgba(22, 119, 255, 0.2);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-illustration {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #7b8ba5;
  text-align: center;
}

.retry-btn {
  margin-top: 28rpx;
  min-width: 240rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: #e8f1ff;
  color: #1677ff;
  font-size: 28rpx;
  font-weight: 600;
}

.loading-state {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #7b8ba5;
}
