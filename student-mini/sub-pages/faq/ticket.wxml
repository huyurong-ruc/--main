<!-- sub-pages/faq/ticket.wxml -->
<view class="container">
  <view class="filter-bar">
    <view
      wx:for="{{statusTabs}}"
      wx:key="value"
      class="filter-chip {{activeStatus === item.value ? 'active' : ''}}"
      bindtap="onStatusChange"
      data-status="{{item.value}}"
    >
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-card">
    <text class="error-text">{{errorMessage}}</text>
    <text class="error-action" bindtap="retryLoad">重新加载</text>
  </view>

  <view class="list">
    <view 
      wx:for="{{tickets}}"
      wx:key="id"
      class="ticket-item"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="ticket-header">
        <text class="ticket-title">工单 #{{item.id}}</text>
        <text class="ticket-status status-{{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="ticket-content">
        <text>{{item.content}}</text>
      </view>
      <view class="ticket-footer">
        <text class="ticket-time">{{item.createTime}}</text>
        <text class="ticket-reply" wx:if="{{item.replyCount > 0}}">{{item.replyCount}}条回复</text>
      </view>
    </view>
  </view>
  
  <view wx:if="{{!loading && !errorMessage && tickets.length === 0}}" class="empty-state">
    <text>暂无工单记录</text>
  </view>
  
  <view wx:if="{{loading}}" class="loading-more">
    <text>加载中...</text>
  </view>

  <view wx:if="{{!loading && tickets.length > 0 && !hasMore}}" class="loading-more">
    <text>没有更多工单了</text>
  </view>
</view>
