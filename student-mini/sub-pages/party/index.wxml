<view class="page">
  <view class="hero">
    <view>
      <text class="hero-kicker">PARTY AFFAIRS</text>
      <text class="hero-title">党团建设</text>
      <text class="hero-subtitle">追踪个人入党入团进度，查看各阶段办理流程</text>
    </view>
    <view class="hero-medal">党</view>
  </view>

  <view class="search-card">
    <view class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="*this"
        class="tab-item {{activeTab === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="onTabChange"
      >
        <text>{{item}}</text>
        <view class="tab-line" wx:if="{{activeTab === index}}"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <block wx:else>
    <view wx:if="{{!hasAnyFlow}}" class="card empty-block">
      <image src="/static/illustrations/party.svg" class="empty-illustration" mode="aspectFit" />
      <text class="empty-title">{{emptyState.title}}</text>
      <text class="empty-desc">{{emptyState.description}}</text>
    </view>

    <view wx:elif="{{activeFlowKey === 'party' ? !(partyProgress && partyProgress.stages.length > 0) : !(leagueProgress && leagueProgress.stages.length > 0)}}" class="card empty-block">
      <image src="/static/illustrations/party.svg" class="empty-illustration" mode="aspectFit" />
      <text class="empty-title">暂无进度数据</text>
      <text class="empty-desc">当前{{activeFlowLabel || '流程'}}尚未关联进度记录</text>
    </view>

    <view wx:else class="card progress-section" bindtap="goToProgress" data-type="{{activeFlowKey}}">
      <view class="section-header">
        <text class="section-title">我的{{activeFlowLabel || '流程'}}进度</text>
        <text class="detail-link">进度详情 →</text>
      </view>

      <view class="timeline" wx:if="{{activeFlowKey === 'party' ? (partyProgress && partyProgress.stages.length > 0) : (leagueProgress && leagueProgress.stages.length > 0)}}">
        <view wx:for="{{activeFlowKey === 'party' ? partyProgress.stages : leagueProgress.stages}}" wx:key="id" class="timeline-item">
          <view class="timeline-dot {{item.statusVariant}}"></view>
          <view class="timeline-content">
            <view class="node-main">
              <text class="node-name">{{item.name}}</text>
              <text class="node-time">预计完成：{{item.expectedTime || '-'}}</text>
            </view>
            <text class="node-status {{item.statusVariant}}">{{item.statusText}}</text>
          </view>
          <view class="timeline-line" wx:if="{{activeFlowKey === 'party' ? index < partyProgress.stages.length - 1 : index < leagueProgress.stages.length - 1}}"></view>
        </view>
      </view>
    </view>

    <view class="card readonly-card">
      <text class="readonly-title">状态更新说明</text>
      <text class="readonly-desc">{{teacherAuditTip}}</text>
    </view>

    <view class="card flow-section" wx:if="{{activeFlowKey === 'party' ? partyFlow.length > 0 : leagueFlow.length > 0}}">
      <view class="section-header">
        <text class="section-title">办理流程说明</text>
      </view>
      <view class="flow-nodes">
        <view wx:for="{{activeFlowKey === 'party' ? partyFlow : leagueFlow}}" wx:key="id" class="flow-node">
          <view class="node-index">{{item.index}}</view>
          <view class="node-info">
            <text class="node-title">{{item.name}}</text>
            <text class="node-desc">{{item.description}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
