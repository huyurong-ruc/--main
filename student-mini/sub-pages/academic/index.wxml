<!-- sub-pages/academic/index.wxml -->
<view class="container">
  <view class="hero-card">
    <view class="hero-content">
      <text class="hero-title">培养方案对比与预览</text>
      <text class="hero-subtitle">上传成绩单 (PDF) 即可获取学业报告，并自动推荐课程</text>
    </view>
    <view class="hero-actions">
      <button class="upload-btn">上传成绩单 (PDF)</button>
      <button class="start-btn">开始上传</button>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">最近报告</text>
    </view>
    <view class="report-list">
      <view class="report-item" bindtap="goToDetail">
        <view class="report-icon">学</view>
        <view class="report-info">
          <text class="report-name">培养方案对比报告</text>
          <view class="report-meta">
            <text class="report-status">已得: 56 / 总分: 155</text>
            <text class="report-time">时间: 2025-03-25</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
