/* sub-pages/academic/index.wxss */
.container {
  padding: 24rpx;
}

.hero-card {
  background: var(--primary-gradient);
  border-radius: 20rpx;
  padding: 40rpx;
  color: #ffffff;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(22, 119, 255, 0.2);
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
}

.hero-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 12rpx;
  display: block;
  line-height: 1.4;
}

.hero-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.upload-btn, .start-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  border-radius: 40rpx;
  padding: 0;
}

.upload-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.start-btn {
  background: #ffffff;
  color: var(--primary-color);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d3d;
  margin-bottom: 24rpx;
}

.report-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(21, 42, 72, 0.04);
}

.report-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #e6f7ff;
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.report-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.report-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.report-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #8a98aa;
}
