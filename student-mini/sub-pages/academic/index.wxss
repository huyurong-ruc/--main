/* sub-pages/academic/index.wxss */
.container {
  min-height: 100vh;
  background: #f4f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-card {
  background: var(--primary-gradient);
  border-radius: 20rpx;
  padding: 40rpx;
  color: #ffffff;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(22, 119, 255, 0.2);
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
}

.hero-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 12rpx;
  display: block;
  line-height: 1.4;
}

.hero-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.hero-actions.single .upload-btn {
  width: 100%;
}

.upload-btn, .start-btn {
  flex: 1;
  font-size: 26rpx;
  border-radius: 40rpx;
  padding: 0 24rpx;
  min-height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

.upload-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.upload-btn-tip {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.3;
  opacity: 0.88;
}

.start-btn {
  background: #ffffff;
  color: var(--primary-color);
  font-weight: 600;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d3d;
  margin-bottom: 24rpx;
}

.status-card,
.empty-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(21, 42, 72, 0.06);
}

.status-item + .status-item {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1f6;
}

.status-label {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.status-label.success {
  background: #f6ffed;
  color: #52c41a;
}

.status-label.history {
  background: #e6f7ff;
  color: #1677ff;
}

.status-value {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #58677d;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d3d;
  display: block;
}

.empty-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #58677d;
  display: block;
}

.empty-btn {
  margin-top: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: var(--primary-color);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.report-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(21, 42, 72, 0.04);
}

.report-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #e6f7ff;
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.report-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.report-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.report-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #8a98aa;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0 40rpx;
  color: #8a98aa;
  font-size: 26rpx;
}
